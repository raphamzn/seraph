[Desktop Entry]
Name=Seraph Reader
GenericName=Markdown Reader
Comment=Read Markdown files with Seraph's renderer
Exec=seraph --view %f
Icon=io.github.raphamzn.SeraphReader
Terminal=false
Type=Application
NoDisplay=true
Categories=Utility;TextTools;Qt;
MimeType=text/markdown;text/x-markdown;
StartupNotify=true
StartupWMClass=seraph-reader
